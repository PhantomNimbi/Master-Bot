{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"types": ["node", "vitest/globals"],
		"allowJs": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"~/*": ["apps/dashboard/src/*"],
			"@master-bot/db": ["packages/db/index.ts"],
			"@master-bot/dashboard": ["apps/dashboard/src/index.ts"],
			"@master-bot/dataService": ["apps/bot/src/dataService.ts"]
		}
	},
	"include": ["tests/**/*.ts"]
}