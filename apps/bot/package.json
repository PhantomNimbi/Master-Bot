{
	"name": "@master-bot/bot",
	"version": "1.0.0",
	"private": true,
	"description": "a discord music bot with guild , gifs and misc commands",
	"author": "Nir Gal",
	"license": "ISC",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"watch": "tsc --watch",
		"type-check": "tsc --noEmit",
		"copy-scripts": "ncp ./scripts/audio ./dist/audio",
		"dev": "pnpm build && pnpm copy-scripts && run-p watch start",
		"start": "node dist/index.js"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@discordjs/collection": "^2.1.1",
		"@lavalink/encoding": "^0.1.2",
		"@master-bot/dashboard": "^1.0.0",
		"@master-bot/db": "^0.1.0",
		"@napi-rs/canvas": "^1.0.8",
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/discord.js-utilities": "^7.3.3",
		"@sapphire/framework": "^4.8.2",
		"@sapphire/plugin-editable-commands": "^2.0.1",
		"@sapphire/plugin-hmr": "^2.0.3",
		"@sapphire/plugin-subcommands": "^7.0.0",
		"@sapphire/time-utilities": "^1.7.14",
		"@sapphire/utilities": "^3.18.2",
		"axios": "^1.20.0",
		"colorette": "^2.0.20",
		"discord.js": "^14.27.0",
		"dotenv": "^16.6.1",
		"genius-discord-lyrics": "1.0.5",
		"google-translate-api-x": "^10.7.3",
		"iso-639-1": "^3.1.6",
		"lavalink-client": "2.2.0",
		"metadata-filter": "^1.3.0",
		"ncp": "^2.0.0",
		"npm-run-all": "^4.1.5",
		"picocolors": "^1.1.0",
		"string-progressbar": "^1.0.4",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^22.5.4",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"dotenv-cli": "^7.4.4",
		"prettier": "^3.9.6",
		"tslib": "^2.8.1",
		"typescript": "^5.5.4"
	},
	"eslintConfig": {
		"root": true,
		"extends": [
			"@master-bot/eslint-config/base"
		]
	}
}
