{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"]
		},
		"plugins": [{ "name": "next" }],
		"strict": true
	},
	"ignoreDeprecations": "6.0",
	"include": ["next-env.d.ts", "src", "*.ts", "*.mjs", ".next/types/**/*.ts"],
	"exclude": ["node_modules"],
}
