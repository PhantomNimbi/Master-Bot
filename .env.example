YOUTUBE_CIPHER_PASSWORD=""

# Spotify Integration
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Twitch & IGDB Integration
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Third-Party APIs
