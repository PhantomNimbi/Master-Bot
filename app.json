{
  "name": "Master-Bot",
  "description": "High-performance Discord bot and Next.js dashboard with zero-binary ioredis-mock and SQLite persistence.",
  "keywords": [
    "discord",
    "bot",
    "music",
    "dashboard",
    "nextjs",
    "typescript"
  ],
  "repository": "https://github.com/galnir/Master-Bot",
  "logo": "https://raw.githubusercontent.com/galnir/Master-Bot/main/apps/dashboard/public/favicon.ico",
  "success_url": "/dashboard",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "env": {
    "NODE_ENV": {
      "value": "production"
    },
    "NODEJS_ALLOW_WIDE_RANG": {
      "description": "Allow wide range requests",
      "value": "true",
      "required": false
    },
    "DISCORD_TOKEN": {
      "description": "Discord Bot Token from the Discord Developer Portal",
      "required": true
    },
    "DISCORD_CLIENT_ID": {
      "description": "Discord Application Client ID",
      "required": true
    },
    "DISCORD_CLIENT_SECRET": {
      "description": "Discord Application Client Secret",
      "required": true
    },
    "INTERNAL_URL": {
      "description": "The internal URL of your deployed application (e.g. https://localhost:3000)",
      "value": "https://localhost:3000",
      "required": true
    },
    "PUBLIC_URL": {
      "description": "The public URL of your deployed application (e.g. https://your-app.herokuapp.com)",
      "required": true
    },
    "DISCORD_CALLBACK_URL": {
      "value": "https://discord.com/api/oauth2/authorize?client_id=your-client-id&permissions=8&scope=bot",
      "description": "Public OAuth2 bot invite URL (Replace your-clinet-id with your discord application's client id)",
      "required": true
    },
    "LAVA_ENABLED": {
      "value": "false",
      "description": "Set to false by default on cloud hosts (requires external Lavalink for music)",
      "required": false
    },
    "LAVA_EXTERNAL": {
      "value": "false",
      "description": "Defaults to true for cloud deployments to connect to an external Lavalink instance",
      "required": false
    },
    "LAVA_HOST": {
      "description": "The public URL of the Lavalink instance (e.g. https://your-domain.com)",
      "required": false
    },
    "LAVA_PASS": {
      "value": "youshallnotpass",
      "required": false
    },
    "LAVA_PORT": {
      "value": "2333",
      "required": false
    },
    "LAVA_SECURE": {
      "value": "true",
      "required": false
    },
    "TWITCH_CLIENT_ID": {
      "description": "Twitch Application Client ID",
      "required": false
    },
    "TWITCH_CLIENT_SECRET": {
      "description": "Twitch Application Client Secret",
      "required": false
    },
    "KLIPY_API": {
      "description": "Klipy API Key",
      "required": false
    },
    "NEWS_API": {
      "description": "News API Key",
      "required": false
    },
    "GENIUS_API": {
      "description": "Genius API Key",
      "required": false
    }
  }
}